# Copy to /volume1/docker/allegro-mcp/config/prywatne.env outside the repository.
ALLEGRO_CLIENT_ID=REPLACE_WITH_PRIVATE_APP_CLIENT_ID
ALLEGRO_CLIENT_SECRET=REPLACE_WITH_PRIVATE_APP_CLIENT_SECRET
ALLEGRO_AUTH_FLOW=device
ALLEGRO_ENVIRONMENT=production
ALLEGRO_ENABLE_WRITES=false
ALLEGRO_TOKEN_STORE_PATH=/home/mcp/.allegro-mcp/tokens.json
ALLEGRO_ACCEPT_LANGUAGE=pl-PL
