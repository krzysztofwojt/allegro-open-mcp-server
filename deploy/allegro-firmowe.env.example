# Copy to /volume1/docker/allegro-mcp/config/firmowe.env outside the repository.
ALLEGRO_CLIENT_ID=REPLACE_WITH_APP_CLIENT_ID
ALLEGRO_CLIENT_SECRET=REPLACE_WITH_APP_CLIENT_SECRET
ALLEGRO_AUTH_FLOW=device
ALLEGRO_ENVIRONMENT=production
ALLEGRO_ENABLE_WRITES=false
ALLEGRO_TOKEN_STORE_PATH=/home/mcp/.allegro-mcp/tokens.json
ALLEGRO_ACCEPT_LANGUAGE=pl-PL
# Generate for your registered application at https://apps.developer.allegro.pl/user-agent
ALLEGRO_USER_AGENT=Registered-App-Name/2026.10.03 (+https://example.org/app-documentation)
ALLEGRO_SCOPES=allegro:api:sale:offers:read,allegro:api:sale:settings:read,allegro:api:orders:read,allegro:api:billing:read,allegro:api:payments:read,allegro:api:profile:read,allegro:api:fulfillment:read,allegro:api:shipments:read,allegro:api:affiliate:read,allegro:api:ratings,allegro:api:disputes,allegro:api:messaging
